# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required for the Pengguna (user management) page — creating/deleting accounts
# and changing roles needs the service role key. Never expose it to the client.
# Get it from Supabase Dashboard > Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Required for the Cetak Jadwal PDF preview — converts the generated .xlsx to
# PDF via Aspose Cells Cloud. Get these from dashboard.aspose.cloud (free tier).
ASPOSE_CLIENT_ID=your-aspose-client-id
ASPOSE_CLIENT_SECRET=your-aspose-client-secret
